# ==============================================================================
# Corporate Office Store Management System - Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real .env, .env.local, or .env.production files to git.
# - Leave ENABLE_MOCK_SERVICES="false" and ALLOW_DEMO_AUTH="false" in production.
# - Generate SESSION_SECRET with: openssl rand -hex 32
# ==============================================================================

# Application URL (used for CORS origin checks & password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated explicit CORS origin allowlist (no wildcards in production)
ALLOWED_ORIGINS="http://localhost:3000"

# Cryptographic HMAC signing secret (>= 32 chars) for HttpOnly session cookies
SESSION_SECRET="replace-with-at-least-32-character-random-secret"

# Mock & Demo Controls (STRICTLY disabled in production)
# Options: "true" (local sandbox only), "false" (strict cloud / production)
ENABLE_MOCK_SERVICES="false"
ALLOW_DEMO_AUTH="false"
ALLOW_ADMIN_SEED="false"

# Default role for non-production mock fallback when Clerk & session cookies are absent
# Options: "EMPLOYEE", "MANAGER", "ADMIN" (keep lowest privilege: EMPLOYEE)
DEFAULT_MOCK_ROLE="EMPLOYEE"

# Optional database pool override in development (do not enable in production)
MOCK_DATABASE="false"

# ------------------------------------------------------------------------------
# 1. Authentication: Clerk
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_clerk_publishable_key_example"
CLERK_SECRET_KEY="sk_test_placeholder_clerk_secret_key_example"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ------------------------------------------------------------------------------
# 2. Database: Neon Serverless Postgres
# ------------------------------------------------------------------------------
# Pooled connection string (with PgBouncer - for transactional serverless queries)
DATABASE_URL="postgresql://neondb_owner:mock_password@ep-mock-pooler.us-east-2.aws.neon.tech/office_store?sslmode=require"
# Direct unpooled connection string (used for schema migrations and Drizzle Kit)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:mock_password@ep-mock-direct.us-east-2.aws.neon.tech/office_store?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Cache & Idempotency: Upstash Redis
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://mock-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="mock_upstash_redis_token_example"

# ------------------------------------------------------------------------------
# 4. Async Worker Queue: Upstash QStash
# ------------------------------------------------------------------------------
QSTASH_URL="https://qstash.upstash.io/v2"
QSTASH_TOKEN="mock_qstash_token_example"
QSTASH_CURRENT_SIGNING_KEY="sigkey_mock_current_example"
QSTASH_NEXT_SIGNING_KEY="sigkey_mock_next_example"

# ------------------------------------------------------------------------------
# 5. Object Storage: Cloudflare R2 (S3-Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="mock_cloudflare_account_id"
R2_ACCESS_KEY_ID="mock_r2_access_key_id"
R2_SECRET_ACCESS_KEY="mock_r2_secret_access_key"
R2_BUCKET_NAME="office-store-attachments"
R2_PUBLIC_URL="https://pub-mock-r2.office-store.dev"

# ------------------------------------------------------------------------------
# 6. Notifications & Emails: Resend
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_mock_placeholder_resend_api_key"
EMAIL_FROM="Office Store <orders@officestore.local>"

# ------------------------------------------------------------------------------
# 7. Business Logic Defaults
# ------------------------------------------------------------------------------
DEFAULT_APPROVAL_THRESHOLD_CENTS="10000" # $100.00
DEFAULT_COMPANY_NAME="Office Store"
DEFAULT_PRIMARY_COLOR="#0f172a"
